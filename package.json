{
  "name": "send2me-rust-app",
  "private": true,
  "version": "0.0.1",
  "author": "Gaurav Patil",
  "license": "MIT",
  "description": "Send2Me — Fast, 100% private direct peer-to-peer file transfer and folder sync",
  "type": "module",
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix apps/desktop run dev:frontend",
    "dev:engine": "npm --prefix apps/desktop run dev:engine",
    "kill:dev": "node scripts/predev.mjs --dev-only",
    "test:lifecycle": "node scripts/test-dev-lifecycle.mjs",
    "test:playwright": "node scripts/test-playwright.mjs",
    "test": "npm run test:lifecycle && npm run test:playwright",
    "build": "npm --prefix apps/desktop run build",
    "build:frontend": "npm --prefix apps/desktop run build:frontend",
    "ship": "node scripts/ship.mjs",
    "vault:pack": "node scripts/vault.mjs pack",
    "vault:unpack": "node scripts/vault.mjs unpack",
    "vault:status": "node scripts/vault.mjs status",
    "lint": "npm --prefix apps/desktop run lint",
    "preview": "npm --prefix apps/desktop run preview",
    "tauri": "npm --prefix apps/desktop run tauri"
  }
}
