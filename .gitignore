# =============================================================================
# Send2Me .gitignore
# Prevents accidental commits of temporary, build, runtime, and secret files
# =============================================================================

# ─── Dependencies & Package Managers ─────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/
.pnp.*

# ─── Rust & Tauri Build Outputs ──────────────────────────────────────────────
target/
**/target/
dist/
dist-ssr/
build/
out/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/WixTools/
nsis-output.exe
**/*.rs.bk
*.pdb

# ─── Android / Mobile / Gradle Outputs ───────────────────────────────────────
.gradle/
local.properties
*.apk
*.aab
gen/android/
gen/apple/

# ─── Local Release Staging & Artifacts ───────────────────────────────────────
windows_assets/
android_assets/
macos_assets/
linux_assets/
all_release_assets/
staged_downloads/
SHA256SUMS.txt
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.tar.gz
*.zip

# ─── Runtime Databases & Local Data (SQLite / Manifests) ────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
manifest.db*
drive.db*
settings.json
*.send2me.tmp
*.unconfirmed.*

# ─── TypeScript / Vite / Bundler Caches ──────────────────────────────────────
*.tsbuildinfo
.turbo/
.vercel/
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.vite/

# ─── Environment, Secrets & Certificates ─────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.jks
*.keystore
secrets.*
signing.key

# ─── Logs & Diagnostics ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
diagnose-*.sh

# ─── Editor / IDE / AI Assistants ────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.cursor/
.claude/
.gemini/
.aider*
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS-Generated Files ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Temporary Files & Scratch ───────────────────────────────────────────────
*.tmp
*.temp
tmp/
temp/
.local/
reference-read-only/
refrenve-only-redme/
trainplex/
coverage/
.nyc_output/
*.lcov